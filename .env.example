# Cursor Cloud Agents API — https://cursor.com/dashboard/integrations
CURSOR_API_KEY=

# App display name — header title and browser tab (default: Cursor Ops)
APP_TITLE=Cursor Ops

# Jira (Atlassian Cloud) — optional; enables Jira tab when all three are set
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Notion — optional; enables Notion tab when token + database ID(s) are set
# Comma-separated: Label|database-id  (legacy: NOTION_TASKS_DB_ID for one DB)
NOTION_TOKEN=
NOTION_TASKS_DB_IDS=

# GitHub — optional; enables GitHub tab
GITHUB_TOKEN=

# Local agent working directory — leave blank to use this repo's root folder
LOCAL_AGENT_CWD=

# Mail — Gmail unread inbox (true/false)
MAIL_GOOGLE_ENABLED=false

# Google OAuth — Gmail readonly (Google Cloud Console → OAuth client)
# Also enable the Gmail API: https://console.cloud.google.com/apis/library/gmail.googleapis.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth callback base (must match provider console redirect URIs)
OAUTH_REDIRECT_BASE=http://localhost:3001
# Where to send the browser after OAuth (Vite dev server)
APP_UI_BASE=http://localhost:5173
