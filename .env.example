# Cursor Cloud Agents API — https://cursor.com/dashboard/integrations
CURSOR_API_KEY=

# App display name — header title and browser tab (default: Cursor Ops)
APP_TITLE=Cursor Ops

# Jira (Atlassian Cloud) — optional; enables Jira tab when all three are set
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Notion — optional; enables Notion tab when token + database ID(s) are set
# Comma-separated: Label|database-id  (legacy: NOTION_TASKS_DB_ID for one DB)
NOTION_TOKEN=
NOTION_TASKS_DB_IDS=
# NOTION_TASKS_DB_ID=

# GitHub — optional; enables GitHub tab
GITHUB_TOKEN=

# Local agent working directory — leave blank to use this repo's root folder
LOCAL_AGENT_CWD=

# Webex Meetings — today's schedule on Pulse (OAuth integration, not a personal token)
# 1. developer.webex.com → My Webex Apps → Create an Integration
# 2. Scopes: meeting:schedules_read (spark:people_read optional, for your email in Setup)
# 3. Redirect URI: {OAUTH_REDIRECT_BASE}/api/webex/auth/callback
#    e.g. http://localhost:3001/api/webex/auth/callback
# 4. Set WEBEX_ENABLED=true, restart, then Setup → Webex → Connect Webex
# Tokens save to .webex-tokens.json (gitignored); refresh tokens avoid 12-hour expiry.
WEBEX_ENABLED=false
WEBEX_CLIENT_ID=
WEBEX_CLIENT_SECRET=

# Mail — Gmail unread inbox (true/false)
MAIL_GOOGLE_ENABLED=false

# Google OAuth — Gmail readonly (Google Cloud Console → OAuth client)
# Also enable the Gmail API: https://console.cloud.google.com/apis/library/gmail.googleapis.com
# Redirect URI: {OAUTH_REDIRECT_BASE}/api/mail/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth callback base (must match redirect URIs in Google + Webex consoles)
OAUTH_REDIRECT_BASE=http://localhost:3001
# Where to send the browser after OAuth (Vite dev server)
APP_UI_BASE=http://localhost:5173
