# Cursor Cloud Agents API — https://cursor.com/dashboard/integrations
CURSOR_API_KEY=

# App display name — header title and browser tab (default: Cursor Ops)
APP_TITLE=Cursor Ops

# Jira (Atlassian Cloud)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=

# Notion — comma-separated database IDs (sprints, projects, task boards)
# Legacy single-ID var NOTION_TASKS_DB_ID still works if set alone
NOTION_TOKEN=
NOTION_TASKS_DB_IDS=b7376c409d214cedbd58e94aefae4927

# GitHub (optional — falls back to `gh` CLI if installed)
GITHUB_TOKEN=

# Local agent default working directory
LOCAL_AGENT_CWD=/Users/iriedevelopment/Projects/cursor-ops
